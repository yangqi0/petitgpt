          },
          "authorized_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization_status": {
            "const": "AUTHORIZED"
          }
        }
      },
      "then": {
        "properties": {
          "authorizes_adapter_execution": {
            "const": true
